# Example environment variables for the Python backend
# Copy this to .env and fill values (do NOT commit secrets to git)

# MongoDB connection (optional if using defaults)
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=rgm_tool_prod
# PORT=4000

# --- Google Calendar configuration ---
# Option A: Use Google Calendar API (recommended for reliability)
# 1) Enable the Google Calendar API in Google Cloud Console
# 2) Create an API key (or service account + appropriate access for private calendars)
# 3) Set the API key below and list comma-separated calendar IDs
GOOGLE_CALENDAR_IDS=en-gb.indian#holiday@group.v.calendar.google.com
GOOGLE_CALENDAR_API_KEY=AIzaSyC0BATONVZha2F2u-2F8sbf3FJ9evf4b3Y
GOOGLE_CALENDAR_SYNC_ON_READ=true

# Option B: Use public ICS feed URLs (no API key required)
# Provide comma-separated ICS URLs
# GOOGLE_CALENDAR_ICS_URLS=https://example.com/calendar.ics,https://another.example/calendar.ics

# Optional tuning
# GOOGLE_CALENDAR_LOOKAHEAD_DAYS=365
# GOOGLE_CALENDAR_MAX_RESULTS=250
